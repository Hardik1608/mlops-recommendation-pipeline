# Copy to .env for local overrides. Every setting maps to recsys.config.Settings
# (prefix RECSYS_). No secrets are required for local runs.

# --- data / paths
RECSYS_DATASET=ml-1m                    # ml-latest-small | ml-1m | ml-25m | ml-32m | synthetic
RECSYS_DATA_DIR=data
RECSYS_ARTIFACTS_DIR=artifacts
RECSYS_REPORTS_DIR=reports

# --- experiment tracking / registry
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db   # http://localhost:5000 with docker compose
RECSYS_REGISTERED_MODEL_NAME=recsys-ranker

# --- serving
RECSYS_MODEL_SOURCE=local               # local (artifacts/models/<alias>) | mlflow (registry aliases)
RECSYS_CHAMPION_MODEL_DIR=artifacts/models/champion
RECSYS_CHALLENGER_MODEL_DIR=artifacts/models/challenger
RECSYS_CHALLENGER_TRAFFIC=0.1           # share of users routed to the challenger
RECSYS_SHADOW_TRAFFIC=0.2               # share of requests also scored by the shadow model (alias "shadow")
RECSYS_AB_SALT=recsys-ab-v1
RECSYS_MODEL_REFRESH_SECONDS=0          # >0 with model_source=mlflow: hot-swap on alias change
RECSYS_CACHE_BACKEND=memory             # memory | redis | none
RECSYS_CACHE_TTL_SECONDS=300
RECSYS_REDIS_URL=redis://localhost:6379/0

# --- features
RECSYS_FEATURE_BACKEND=memory           # memory | feast
RECSYS_FEAST_YAML=feature_store.yaml    # feature_store.redis.yaml (compose) / .k8s.yaml (cluster)
RECSYS_FEATURE_STORE_IN_THREAD=true     # false for the local SQLite store (GIL-bound lookups)
# FEAST_REDIS_CONNECTION_STRING=localhost:6379,db=1
# FEAST_REGISTRY_URL=postgresql+psycopg://feast:<password>@localhost:5432/feast

# --- streaming
RECSYS_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
RECSYS_KAFKA_TOPIC=ratings.v1

# --- monitoring
# RECSYS_PUSHGATEWAY_URL=http://localhost:9091
RECSYS_LOG_LEVEL=INFO
RECSYS_LOG_FORMAT=text                  # text | json
